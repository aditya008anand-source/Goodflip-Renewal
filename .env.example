# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - server-side only, NEVER expose to the browser.
# Used by: the Google Sheets sync API route, the one-off November import script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Published Google Sheet CSV export link (File -> Share -> Publish to web -> CSV)
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?output=csv

# Shared secret required in the request header when triggering /api/sync-sheet
# from the Settings page "Sync now" button or from an external scheduler (e.g. Vercel Cron).
SYNC_API_SECRET=choose-a-long-random-string
